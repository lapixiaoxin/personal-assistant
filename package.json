{
  "name": "lumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "esbuild",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  },
  "scripts": {
    "build": "pnpm build:server",
    "build:server": "node scripts/clean-dist.mjs && tsup",
    "check": "pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm check:dsh && pnpm test && pnpm check:build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:build": "pnpm build && node scripts/check-build-output.mjs",
    "check:dsh": "node scripts/check-dsh-compat.mjs",
    "check:dsh:latest": "node scripts/check-dsh-latest.mjs",
    "dev": "node --env-file-if-exists=.env --watch apps/server/src/main.js",
    "dsh:web:minimax-cn": "DSH_HOME=./data/dsh-web node --env-file-if-exists=.env ./node_modules/@deepseek-ai/dsh/lib/bin.js web --patch ./profiles/providers/minimax-cn.patch.yml --no-open --host 127.0.0.1 --port 3081",
    "lint": "eslint .",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "server:status": "node --env-file-if-exists=.env apps/server/src/status.js",
    "test": "vitest run",
    "test:dsh": "vitest run tests/contract/dsh-channels.test.js",
    "test:dsh:bundle": "node scripts/verify-dsh-lumi-bundle.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.0-rc.2",
    "@lumi/dsh-channels-plugin": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-mock-server": "0.2.0-rc.2",
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.6",
    "eslint": "9.36.0",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
