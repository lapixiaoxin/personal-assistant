{
  "name": "lumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "esbuild",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  },
  "scripts": {
    "build": "pnpm build:server && pnpm --filter @lumi/workbench build",
    "build:server": "tsup",
    "check": "pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm check:dsh && pnpm test && pnpm build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:dsh": "node scripts/check-dsh-compat.mjs",
    "check:dsh:latest": "node scripts/check-dsh-latest.mjs",
    "cli": "tsx apps/local-runner/src/main.ts",
    "dev": "tsx watch apps/gateway/src/main.ts",
    "dev:web": "pnpm --filter @lumi/workbench dev",
    "dsh:web:minimax-cn": "DSH_HOME=./data/dsh-web dsh web --patch ./profiles/providers/minimax-cn.patch.yml --no-open --host 127.0.0.1 --port 3081",
    "lint": "eslint .",
    "start": "node dist/gateway/main.js",
    "test": "vitest run",
    "test:dsh": "vitest run tests/contract/dsh-runtime.test.ts",
    "test:dsh:bundle": "node scripts/verify-dsh-lumi-bundle.mjs",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.7-rc.2",
    "commander": "14.0.1",
    "fastify": "5.6.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@deepseek-ai/dsh-llm-mock-server": "0.1.7-rc.2",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.36.0",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
