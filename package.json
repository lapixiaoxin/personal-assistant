{
  "name": "lumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "esbuild",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  },
  "scripts": {
    "build": "./scripts/with-project-node.sh pnpm build:host",
    "build:host": "./scripts/with-project-node.sh sh -c 'node scripts/clean-dist.mjs && tsup'",
    "check": "./scripts/with-project-node.sh sh -c 'pnpm lint && pnpm typecheck && pnpm check:architecture && pnpm check:dsh && pnpm test && pnpm check:build'",
    "check:architecture": "./scripts/with-project-node.sh node scripts/check-architecture.mjs",
    "check:build": "./scripts/with-project-node.sh sh -c 'pnpm build && node scripts/check-build-output.mjs'",
    "check:dsh": "./scripts/with-project-node.sh node scripts/check-dsh-compat.mjs",
    "check:dsh:latest": "./scripts/with-project-node.sh node scripts/check-dsh-latest.mjs",
    "dev": "./scripts/with-project-node.sh node --env-file-if-exists=.env --watch host/src/main.js",
    "dsh:web:minimax-cn": "./scripts/with-project-node.sh env DSH_HOME=./data/dsh-web node --env-file-if-exists=.env ./node_modules/@deepseek-ai/dsh/lib/bin.js web --patch ./profiles/providers/minimax-cn.patch.yml --no-open --host 127.0.0.1 --port 3081",
    "lint": "./scripts/with-project-node.sh eslint .",
    "start": "./scripts/with-project-node.sh node --env-file-if-exists=.env dist/server/main.js",
    "server:status": "./scripts/with-project-node.sh node --env-file-if-exists=.env host/src/status.js",
    "test": "./scripts/with-project-node.sh vitest run",
    "test:dsh": "./scripts/with-project-node.sh vitest run tests/contract/host-channel.test.js",
    "test:dsh:bundle": "./scripts/with-project-node.sh node scripts/verify-personal-context-bundle.mjs",
    "test:watch": "./scripts/with-project-node.sh vitest",
    "typecheck": "./scripts/with-project-node.sh tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.2.0-rc.2",
    "@lumi/host": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-mock-server": "0.2.0-rc.2",
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.6",
    "eslint": "9.36.0",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
