[Unit]
Description=lumi personal steward (DSH + Feishu)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lumi
Group=lumi
WorkingDirectory=/opt/lumi
Environment=LUMI_SERVER_CONFIG=/opt/lumi/data/server/config.json
ExecStart=/usr/bin/node --env-file-if-exists=/opt/lumi/.env /opt/lumi/dist/server/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lumi/data

[Install]
WantedBy=multi-user.target
