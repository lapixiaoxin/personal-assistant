# New default server: edit private data/server/config.json.
# LUMI_SERVER_CONFIG=./data/server/config.json
# Model selection is in that JSON. Only model keys belong here:
# MINIMAX_CN_API_KEY=
# MINIMAX_API_KEY=
# DEEPSEEK_API_KEY=
# LUMI_MODEL_API_KEY=
# Feishu secrets belong ONLY in the private JSON, not environment variables.
#
# Legacy CLI / Gateway / Workbench settings below:
PA_HOST=127.0.0.1
PA_PORT=4310
PA_DATA_DIR=./data
PA_EXECUTOR=dsh
PA_OWNER_ID=local-owner
PA_PRINCIPAL_ID=local-user
# Generate a private value with: openssl rand -hex 32
# PA_HTTP_TOKEN=
# PA_ARTIFACT_ROOT=./data/artifacts

# MiniMax China configuration. Use provider=minimax and MINIMAX_API_KEY for
# an international account.
PA_DSH_PROVIDER=minimax-cn
PA_DSH_MODEL=MiniMax-M3
PA_DSH_MAX_TOKENS=8192
# PA_DSH_HOME=./data/dsh
# MINIMAX_CN_API_KEY=
# MINIMAX_API_KEY=

# DeepSeek alternative:
# PA_DSH_PROVIDER=deepseek-official
# PA_DSH_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
